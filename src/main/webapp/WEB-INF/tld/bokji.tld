<?xml version="1.0" encoding="UTF-8"?>
<taglib xmlns="http://java.sun.com/xml/ns/javaee" version="2.1">
    <tlib-version>1.0</tlib-version>
    <short-name>bk</short-name>
    <uri>http://bokji.ieum/functions</uri>
    <function>
        <description>전화번호 한 칸을 번호별 목록으로 나눈다</description>
        <name>phones</name>
        <function-class>com.ieum.bokji.util.TextUtil</function-class>
        <function-signature>java.util.List splitPhones(java.lang.String)</function-signature>
    </function>
    <function>
        <description>tel: 링크용 숫자 문자열</description>
        <name>tel</name>
        <function-class>com.ieum.bokji.util.TextUtil</function-class>
        <function-signature>java.lang.String telDigits(java.lang.String)</function-signature>
    </function>
    <function>
        <description>원문·번역 전화번호 조각이 번호별로 대응되는지</description>
        <name>aligned</name>
        <function-class>com.ieum.bokji.util.TextUtil</function-class>
        <function-signature>boolean phonesAligned(java.lang.String, java.lang.String)</function-signature>
    </function>
    <function>
        <description>원문·번역이 같은 번호 집합인지</description>
        <name>sameNumbers</name>
        <function-class>com.ieum.bokji.util.TextUtil</function-class>
        <function-signature>boolean sameNumbers(java.lang.String, java.lang.String)</function-signature>
    </function>
    <function>
        <description>카드용 대표 번호</description>
        <name>firstPhone</name>
        <function-class>com.ieum.bokji.util.TextUtil</function-class>
        <function-signature>java.lang.String firstPhone(java.lang.String, java.lang.String)</function-signature>
    </function>
</taglib>

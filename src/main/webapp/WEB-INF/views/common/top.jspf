<%-- 공통 상단: <c:set var="pageTitle">…</c:set> 후 include. ctx·langCode 변수 제공. --%>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<c:set var="langCode" value="${empty pageContext.response.locale.language ? 'ko' : pageContext.response.locale.language}"/>
<!DOCTYPE html>
<html lang="${langCode}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${pageTitle}"/> — <spring:message code="app.title"/></title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
    <link rel="stylesheet" href="${ctx}/static/css/bokji.css?v=5">
    <script>
        /* [글자 크게] 토글: sessionStorage 유지, FOUC 방지 위해 head에서 즉시 적용 */
        try {
            var bkF = sessionStorage.getItem('bkFontStep');
            if (bkF === '1') document.documentElement.style.fontSize = '112.5%';
            else if (bkF === '2') document.documentElement.style.fontSize = '125%';
        } catch (e) {}
    </script>
</head>
<body>
<header class="bk-topbar bk-noprint">
    <div class="container d-flex flex-wrap align-items-center justify-content-between gap-2">
        <a class="bk-logo" href="${ctx}/"><svg class="bk-logo-mark" aria-hidden="true"><use href="${ctx}/static/img/icons.svg#logo"/></svg><spring:message code="app.title"/></a>
        <nav class="bk-lang" aria-label="language">
            <a href="?lang=ko" ${langCode == 'ko' ? 'class="active" aria-current="true"' : ''}>한국어</a>
            <a href="?lang=en" ${langCode == 'en' ? 'class="active" aria-current="true"' : ''}>EN</a>
            <a href="?lang=zh" ${langCode == 'zh' ? 'class="active" aria-current="true"' : ''}>中文</a>
            <a href="?lang=vi" ${langCode == 'vi' ? 'class="active" aria-current="true"' : ''}>Tiếng Việt</a>
        </nav>
        <div class="d-flex gap-2">
            <button type="button" id="bkFontToggle" class="btn btn-bk-outline btn-sm" aria-pressed="false">
                <spring:message code="nav.fontSize"/>
            </button>
            <a class="btn btn-bk-outline btn-sm d-inline-flex align-items-center" href="${ctx}/">
                <spring:message code="nav.restart"/>
            </a>
        </div>
    </div>
</header>
<main class="container py-4" style="max-width: 860px">

<%-- 관리자 공통 상단 (내부 도구 — 한국어 고정). <c:set var="pageTitle">…</c:set> 후 include. --%>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${pageTitle}"/> — 복지이음 관리자</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
    <link rel="stylesheet" href="${ctx}/static/css/bokji.css?v=2">
</head>
<body>
<nav class="navbar navbar-expand bk-admin-nav navbar-dark">
    <div class="container-fluid px-3">
        <a class="navbar-brand fw-bold" href="${ctx}/admin/resources">복지이음 관리자</a>
        <div class="navbar-nav">
            <a class="nav-link" href="${ctx}/admin/resources">자원 관리</a>
            <a class="nav-link" href="${ctx}/admin/reports">제보 처리</a>
        </div>
        <div class="ms-auto d-flex align-items-center gap-2 text-white">
            <span><c:out value="${sessionScope.adminName}"/> 님</span>
            <a class="btn btn-outline-light btn-sm" href="${ctx}/admin/logout">로그아웃</a>
        </div>
    </div>
</nav>
<main class="container-fluid px-3 py-4">
